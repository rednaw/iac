{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ infrastructure_secrets.vpn_uuid }}",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ infrastructure_secrets.vpn_dest }}:443",
          "xver": 0,
          "serverNames": ["{{ infrastructure_secrets.vpn_dest }}"],
          "privateKey": "{{ infrastructure_secrets.vpn_reality_private_key }}",
          "shortIds": ["{{ infrastructure_secrets.vpn_short_id }}"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "direct" }
  ]
}
