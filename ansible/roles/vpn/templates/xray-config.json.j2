{
  "log": { "loglevel": "warning" },
  "api": {
    "tag": "api",
    "listen": "127.0.0.1:{{ vpn_xray_api_port }}",
    "services": ["StatsService"]
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": { "statsUserUplink": true, "statsUserDownlink": true }
    }
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ infrastructure_secrets.vpn_uuid }}",
            "email": "{{ vpn_xray_stats_user }}",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ infrastructure_secrets.vpn_dest }}:443",
          "xver": 0,
          "serverNames": ["{{ infrastructure_secrets.vpn_dest }}"],
          "privateKey": "{{ infrastructure_secrets.vpn_reality_private_key }}",
          "shortIds": ["{{ infrastructure_secrets.vpn_short_id }}"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "direct" }
  ]
}
